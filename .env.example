# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI tutor (at least one provider is required for AI features)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Code execution (JDoodle Compiler REST API; server only)
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_REQUEST_TIMEOUT_MS=30000

# Supabase Auth's built-in email service needs no application environment key.
# Leave custom SMTP disabled in the Supabase Dashboard for the hackathon demo.
