# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI tutor (at least one provider is required for AI features)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Code execution
PISTON_API_URL=https://emkc.org/api/v2/piston
# The public EMKC API now requires provider authorization. Use the exact
# header name/value supplied by the executor. Examples:
# PISTON_AUTH_HEADER=Authorization
# PISTON_AUTH_VALUE=Bearer provider-token
PISTON_AUTH_HEADER=
PISTON_AUTH_VALUE=

# Supabase Auth's built-in email service needs no application environment key.
# Leave custom SMTP disabled in the Supabase Dashboard for the hackathon demo.
