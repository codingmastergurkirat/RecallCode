# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI tutor (at least one provider is required for AI features)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Code execution (local self-hosted Piston Docker container)
PISTON_API_URL=http://127.0.0.1:2000/api/v2
PISTON_RUN_TIMEOUT_MS=3000
# Leave both values empty while Piston is reachable only on your computer.
# For a public deployment, put Piston behind HTTPS and a secret header:
# PISTON_AUTH_HEADER=X-RecallCode-Key
# PISTON_AUTH_VALUE=replace-with-a-long-random-secret
PISTON_AUTH_HEADER=
PISTON_AUTH_VALUE=

# Supabase Auth's built-in email service needs no application environment key.
# Leave custom SMTP disabled in the Supabase Dashboard for the hackathon demo.
